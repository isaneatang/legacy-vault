{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/gen-config.js",
  "outputDirectory": "frontend",
  "rewrites": [
    { "source": "/api/rpc-testnet", "destination": "https://rpc.bohr.life" },
    { "source": "/api/rpc-mainnet", "destination": "https://rpc.botchain.ai" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Access-Control-Allow-Origin", "value": "*" }]
    }
  ]
}
