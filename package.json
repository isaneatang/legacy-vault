{
  "name": "legacy-vault",
  "version": "1.0.0",
  "description": "Legacy Vault - on-chain inheritance / dead man's switch protocol for BOT Chain",
  "license": "MIT",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:gas": "REPORT_GAS=true hardhat test",
